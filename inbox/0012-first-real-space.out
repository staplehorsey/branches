<title>Kept at Golden Hour</title>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #f2b48a; }
  canvas { display: block; }
  #fade { position: fixed; inset: 0; background: #f2b48a; pointer-events: none; opacity: 1; transition: opacity 2.6s ease; z-index: 5; }
  #vig { position: fixed; inset: 0; pointer-events: none; z-index: 4;
         background: radial-gradient(ellipse at center, rgba(0,0,0,0) 55%, rgba(60,20,10,0.28) 100%); }
  #hint { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); color: rgba(90,40,20,.7);
          font: 13px/1.4 Georgia, serif; letter-spacing: .12em; pointer-events: none; transition: opacity 1.6s; z-index: 6; text-align: center; }
  #oops { position: fixed; left: 50%; top: 50%; transform: translate(-50%,-50%); color: #7a3a1e; font: 16px Georgia, serif; display: none; z-index: 7; }
</style>
</head>
<body>
