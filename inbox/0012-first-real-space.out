<script type="module">
import * as THREE from '/vendor/three.module.js';

const B = window.branches || {
  onward() { parent.postMessage({ branches: 'onward' }, '*'); },
  back() { parent.postMessage({ branches: 'back' }, '*'); },
  say(t) { console.log(t); },
};
const say = (t, s) => { try { B.say(t, s); } catch (e) {} };

try { main(); } catch (e) {
  document.getElementById('oops').style.display = 'block';
  document.getElementById('fade').style.opacity = '0';
  throw e;
}

function main() {
  // ------------------------------------------------------------ rng
  let seed = 3601047423;
  const rnd = () => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed / 4294967296; };
  const rr = (a, b) => a + (b - a) * rnd();
  const smooth = (a, b, x) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
  const lerp = (a, b, t) => a + (b - a) * t;

  // ------------------------------------------------------------ world constants
  const R = 14;          // glass radius
  const RMAX = 13.35;    // how far you can walk
  const GLASS_TOP = 18.5;
  const SILL_Y = -0.5;
  let sunElev = 0.1;
  const SUN_AZ = 0;      // the sun lies toward +z
  const sunDir = new THREE.Vector3();
  const updateSunDir = () => sunDir.set(Math.cos(sunElev) * Math.sin(SUN_AZ), Math.sin(sunElev), Math.cos(sunElev) * Math.cos(SUN_AZ));
  updateSunDir();

  // ------------------------------------------------------------ renderer
  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

